# Root-level secrets — never commit the real .env, only .env.example
.env
.env.local
.env.*.local

# .NET build output (was previously untracked only by omission — these were
# committed in git history and must be removed with `git rm -r --cached`)
backend/bin/
backend/obj/

# OS/editor noise
.DS_Store
Thumbs.db
*.swp

# Node (also covered by web/.gitignore, repeated here for anything run from
# the repo root)
node_modules/
.next/
