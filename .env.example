# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. Everything here is consumed by docker-compose.yml and
# by web/lib/env.ts (which validates it at boot and fails fast if anything's
# missing or malformed).

# --- App -----------------------------------------------------------------
NODE_ENV=production
# Public origin the app is served from. Used to build OAuth redirect URIs
# and validate CSRF Origin/Referer headers in middleware.ts. No trailing slash.
APP_ORIGIN=http://localhost:3000
# Name of the session cookie in development only (production always uses the
# stricter __Host-session prefix regardless of this value).
SESSION_COOKIE_NAME=session

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=rentapp
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_DB=rentdb
# Used by the `web`/`migrate` services inside docker-compose (host "db" is
# the compose service name, not localhost).
DATABASE_URL=postgresql://rentapp:change-me-generate-a-real-secret@db:5432/rentdb?schema=public

# --- Redis -------------------------------------------------------------
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=change-me-generate-a-real-secret
REDIS_URL=redis://:change-me-generate-a-real-secret@redis:6379

# --- MinIO / S3-compatible object storage -----------------------------
MINIO_ROOT_USER=rentapp-admin
# Generate with: openssl rand -base64 24
MINIO_ROOT_PASSWORD=change-me-generate-a-real-secret
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=rent-uploads
S3_ACCESS_KEY=rentapp-admin
S3_SECRET_KEY=change-me-generate-a-real-secret
S3_FORCE_PATH_STYLE=true
# Publicly reachable base URL for uploaded objects (what browsers fetch).
# With the default compose setup MinIO's API port is published on 9000.
S3_PUBLIC_URL=http://localhost:9000/rent-uploads
# Hostnames Next's image optimizer is allowed to fetch from (comma-separated).
IMAGE_REMOTE_HOSTS=localhost,minio,127.0.0.1

# --- Google OAuth --------------------------------------------------------
# https://console.cloud.google.com/apis/credentials — authorized redirect
# URI must be exactly {APP_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Third-party APIs ------------------------------------------------------
# https://www.exchangerate-api.com/ — free tier key. NOTE: the key that used
# to live in backend/appsettings.json is committed to git history and must
# be rotated; do not reuse it here.
# Without a real key here, the currency *list* still works (bundled
# fallback, see web/lib/currencies.ts) but conversion *rates* will error —
# see web/lib/currency.ts.
EXCHANGE_RATE_API_KEY=

# --- Adminer (dev only, `docker compose --profile dev up`) ---------------
ADMINER_PORT=8081
